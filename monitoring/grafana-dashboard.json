{
  "title": "AI Travel Agent — Planning Pipeline",
  "uid": "ai-travel-agent",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "HTTP requests/sec", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (handler)", "legendFormat": "{{handler}}" }]
    },
    {
      "id": 2, "title": "HTTP p95 latency", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))", "legendFormat": "{{handler}}" }]
    },
    {
      "id": 3, "title": "Planning duration (p50/p95)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(planning_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(planning_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 4, "title": "Node duration by node (p95)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(node_duration_seconds_bucket[5m])) by (le, node_name))", "legendFormat": "{{node_name}}" }]
    },
    {
      "id": 5, "title": "Tool error rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum(rate(tool_error_total[5m])) by (node_name) / sum(rate(tool_call_total[5m])) by (node_name)", "legendFormat": "{{node_name}}" }]
    },
    {
      "id": 6, "title": "Budget accuracy (% off target)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "histogram_quantile(0.50, sum(rate(budget_accuracy_pct_bucket[15m])) by (le))", "legendFormat": "median overrun %" }]
    }
  ]
}